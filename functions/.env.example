# Non-secret runtime configuration for Firebase Functions.
# Replace with the exact Firestore database ID configured in the Firebase project.
FIRESTORE_DATABASE_ID=your-firestore-database-id

# Full Cloud KMS CryptoKey resource name:
# projects/PROJECT_ID/locations/LOCATION/keyRings/KEY_RING/cryptoKeys/KEY
KMS_KEY_NAME=projects/PROJECT_ID/locations/LOCATION/keyRings/KEY_RING/cryptoKeys/KEY

# Cloud Tasks -> private Cloud Run worker dispatch.
# Create the queue and deploy the worker before setting these values.
CLOUD_TASKS_PROJECT_ID=your-google-cloud-project-id
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=app-designer-jobs
JOB_WORKER_URL=https://your-worker-service-xxxxx-uc.a.run.app/tasks
# Cloud Run OIDC audience is normally the service URL without the /tasks path.
JOB_WORKER_AUDIENCE=https://your-worker-service-xxxxx-uc.a.run.app
JOB_WORKER_SERVICE_ACCOUNT=cloud-tasks-invoker@your-google-cloud-project-id.iam.gserviceaccount.com
