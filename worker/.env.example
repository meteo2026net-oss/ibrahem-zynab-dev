# Cloud Run worker configuration. These are identifiers and URLs, not API keys.
PORT=8080
JOB_WORKER_ID=app-designer-worker
GCP_PROJECT_ID=your-google-cloud-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-3.8-flash
# Firebase Functions v2 base URL in the deployed project and region.
FUNCTIONS_BASE_URL=https://us-central1-your-google-cloud-project-id.cloudfunctions.net
