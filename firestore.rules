rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check ownership for writes
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Stored Files collection
    match /stored_files/{fileId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // GitHub Accounts
    match /github_accounts/{accId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Telegram Bots
    match /telegram_bots/{botId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Telegram Events
    match /telegram_events/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Google Accounts
    match /google_accounts/{accId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // API Credentials
    match /api_credentials/{credId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI Agents
    match /ai_agents/{agentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Approval Requests
    match /approval_requests/{requestId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Sync Records
    match /sync_records/{recordId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Project Backups
    match /project_backups/{backupId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // App Notifications
    match /app_notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Persistent Jobs
    match /persistent_jobs/{jobId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Job Checkpoints
    match /job_checkpoints/{checkpointId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // AI Model Registry (per user/project)
    match /ai_model_registry/{modelId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Failover Logs
    match /failover_logs/{logId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Idempotency Records
    match /idempotency_records/{recordId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Project Secrets Vault
    match /project_secrets_vault/{secretId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Database Connections
    match /database_connections/{connId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isOwner(request.resource.data.userId);
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
