rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwnerImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // Client-managed, user-owned data. The owner field is immutable after creation.
    // Sensitive execution, approval, audit, and credential records are deliberately
    // excluded and must be accessed through a trusted server after authorization.
    match /{collection}/{documentId} {
      allow read: if collection in [
        'projects',
        'tasks',
        'stored_files',
        'ai_agents',
        'telegram_events',
        'sync_records',
        'app_notifications',
        'ai_model_registry',
        'failover_logs'
      ] && ownsExistingDocument();

      allow create: if collection in [
        'projects',
        'tasks',
        'stored_files',
        'ai_agents',
        'telegram_events',
        'sync_records',
        'app_notifications',
        'ai_model_registry',
        'failover_logs'
      ] && ownsNewDocument();

      allow update: if collection in [
        'projects',
        'tasks',
        'stored_files',
        'ai_agents',
        'telegram_events',
        'sync_records',
        'app_notifications',
        'ai_model_registry',
        'failover_logs'
      ] && ownsExistingDocument() && keepsOwnerImmutable();

      allow delete: if collection in [
        'projects',
        'tasks',
        'stored_files',
        'ai_agents',
        'telegram_events',
        'sync_records',
        'app_notifications',
        'ai_model_registry',
        'failover_logs'
      ] && ownsExistingDocument();
    }

    // Read-only records: clients may inspect their own records but cannot forge,
    // rewrite, or erase the audit trail, approvals, job leases, checkpoints, or
    // idempotency outcomes. Trusted server code must perform all mutations.
    match /{collection}/{documentId} {
      allow read: if collection in [
        'audit_logs',
        'approval_requests',
        'persistent_jobs',
        'job_checkpoints',
        'idempotency_records'
      ] && ownsExistingDocument();
      allow write: if false;
    }

    // Credential-bearing collections are server-only. In particular, encrypted
    // values must not be readable by mobile/web clients when the encryption key
    // is shipped inside those clients.
    match /{collection}/{documentId} {
      allow read, write: if false;
    }

    // Deny every document path not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
